# 배포용 설정 견본. 서버에서 복사해 쓴다: cp .env.deploy.example .env.deploy 뒤 값을 채운다
# .env.deploy는 git에 올라가지 않는다. 진짜 비밀번호·키는 서버의 .env.deploy에만 적는다.
# 줄 끝에 # 주석을 달지 않는다 (값에 섞인다).

# 이 배포의 이름. 같은 서버를 쓰는 다른 사람과 겹치지 않게 나만 쓰는 이름 (영어 소문자·숫자·-, 예: 내 도메인 이름)
DEPLOY_NAME=

# 화면 입구 포트 (실습 서버 Nginx가 127.0.0.1:이 포트로 넘긴다). 실습 서버에서는 내 포트 범위 안 (예: 8410)
WEB_PORT=8410

# DB. 비밀번호는 아래 명령으로 만든 무작위 값을 넣는다: openssl rand -hex 24
DB_NAME=myblog
DB_USERNAME=myblog
DB_PASSWORD=

# 이미지 저장소(MinIO) 관리자 계정 = 서버의 접속 키. 키 8자 이상, 비밀 키는 openssl rand -hex 24
IMAGE_S3_BUCKET=myblog-images
IMAGE_S3_ACCESS_KEY=
IMAGE_S3_SECRET_KEY=

# 인증번호 HMAC 비밀키. 32자 이상 무작위: openssl rand -hex 32
VERIFICATION_SECRET=

# 인증 메일 (Gmail: smtp.gmail.com + 앱 비밀번호, 네이버: smtp.naver.com). 적는 법은 .env.example 참고
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 로그인 쿠키를 HTTPS에서만 보낼지. HTTPS(자물쇠)가 붙어 있으면 true(권장).
# 아직 http로만 접속되면 false로 해야 로그인이 된다 (보안이 약해지므로 HTTPS가 붙으면 true로 되돌린다)
SESSION_COOKIE_SECURE=true
