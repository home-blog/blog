# 로컬 개발용 설정 견본. 복사해서 쓴다: cp .env.example .env
# .env는 git에 올라가지 않는다. 진짜 계정(메일 비밀번호 등)은 .env에만 적는다.
# docker-compose.yml과 서버(dev 설정)가 같은 .env를 읽는다. 아래 값은 개발 전용이고 배포에는 쓰지 않는다.
# 줄 끝에 # 주석을 달면 서버가 값에 섞어 읽으므로 값만 적는다.

# DB (PostgreSQL). 비밀번호는 DB를 처음 만들 때만 정해진다. 바꾸려면 docker compose down -v로 DB를 지우고 다시 켠다
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myblog
DB_USERNAME=myblog
DB_PASSWORD=myblog-dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 이미지 저장소 (MinIO, S3 방식). 키는 MinIO 관리자 계정이기도 하다. 들여다보기: http://localhost:9001
IMAGE_S3_ENDPOINT=http://localhost:9000
IMAGE_S3_BUCKET=myblog-images
IMAGE_S3_ACCESS_KEY=myblog-dev
IMAGE_S3_SECRET_KEY=myblog-dev-secret

# 인증 메일. log면 메일 대신 서버 로그에 인증번호를 찍는다.
# 내 메일함으로 받으려면 MAIL_SENDER=smtp로 바꾸고 계정을 적는다.
#   Gmail: MAIL_HOST=smtp.gmail.com, 2단계 인증을 켠 뒤 만든 앱 비밀번호(16자)
#   네이버: MAIL_HOST=smtp.naver.com, 메일 환경설정에서 POP3/SMTP 사용을 켬 (2단계 인증을 쓰면 앱 비밀번호). 보내는 주소는 계정 주소
MAIL_SENDER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
