# 실습 서버 Nginx 설정 견본 (강사님께 적용을 요청하는 파일).
# 공개 저장소라 도메인·학번은 적지 않았다. 서버에서 deploy/make-nginx-conf.sh로 채워 ~/nginx/<도메인>.conf를 만든다.
server {
    listen 80;
    server_name __DOMAIN__;

    access_log __HOME__/nginx/logs/__DOMAIN__.access.log;
    error_log  __HOME__/nginx/logs/__DOMAIN__.error.log;

    # 이미지 한 장 5MB + 여유
    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
    }
}
